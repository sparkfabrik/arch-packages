#!/bin/bash
set -euo pipefail

flags=()
config="${XDG_CONFIG_HOME:-${HOME}/.config}/codex-flags.conf"
if [[ -r "${config}" ]]; then
  while IFS= read -r line || [[ -n "${line}" ]]; do
    line="${line%%#*}"
    read -r -a words <<< "${line}"
    flags+=("${words[@]}")
  done < "${config}"
fi
flags+=("$@")

wayland=()
if [[ -n "${WAYLAND_DISPLAY:-}" || "${XDG_SESSION_TYPE:-}" == wayland ]]; then
  wayland=(--ozone-platform=wayland)
  for flag in "${flags[@]}"; do
    case "${flag}" in
      --ozone-platform|--ozone-platform=*|--ozone-platform-hint|--ozone-platform-hint=*) wayland=(); break ;;
    esac
  done
fi
exec /usr/lib/chatgpt/ChatGPT "${wayland[@]}" "${flags[@]}"
