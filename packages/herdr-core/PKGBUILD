# Maintainer: SparkFabrik platform team
# Reproduces the reviewed effects of upstream's install script without running
# it; see UPSTREAM-REVIEW.md before changing this recipe.
pkgname=herdr-core
pkgver=0.1.21
pkgrel=1
pkgdesc='Terminals for coding agents that keep running (hc CLI and core server)'
arch=('x86_64')
url='https://herdr.dev/core/'
license=('Apache-2.0')
options=('!strip' '!debug')
optdepends=(
  'openssh: manage terminals on other machines with hc machine'
)
source_x86_64=("${pkgname}-${pkgver}-${CARCH}.tar.gz::https://releases.herdr.dev/core/${pkgver}/herdr-core-linux-${CARCH}.tar.gz")
sha256sums_x86_64=('78424755c10a40dde38a0bdb55c20ac19706e9ae05ed68fc2acf1fcff0d941c1')

package() {
  install -Dm755 "${srcdir}/herdr-core" "${pkgdir}/usr/bin/herdr-core"
  ln -s herdr-core "${pkgdir}/usr/bin/hc"
  install -Dm644 "${srcdir}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 "${srcdir}/THIRD-PARTY-NOTICES" "${pkgdir}/usr/share/licenses/${pkgname}/THIRD-PARTY-NOTICES"
}
